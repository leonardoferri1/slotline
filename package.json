{
  "name": "slotline",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build -w @slotline/api && npm run build -w @slotline/web",
    "dev": "npm run build -w @slotline/api && node scripts/local.mjs",
    "test": "npm run build -w @slotline/api && node scripts/test.mjs",
    "test:external": "npm run build -w @slotline/api && node --test apps/api/dist/test/*.test.js",
    "db:migrate": "node apps/api/dist/src/migrate.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
